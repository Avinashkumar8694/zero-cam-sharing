{
  "name": "fabrixly-cam-sharing",
  "private": true,
  "version": "1.0.0",
  "description": "Fabrixly Cam Sharing App",
  "author": {
    "name": "Fabrixly",
    "email": "admin@fabrixly.com"
  },
  "homepage": "https://cam-share.fabrixly.com",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "concurrently \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "dev": "vite",
    "build": "node copy-builds.js && tsc -b && vite build",
    "build:mac": "cross-env ELECTRON=1 npm run build && electron-builder --mac",
    "build:win": "cross-env ELECTRON=1 npm run build && electron-builder --win",
    "build:linux": "cross-env ELECTRON=1 npm run build && electron-builder --linux",
    "cap:sync": "npm run build && npx cap sync",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/share": "^8.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "framer-motion": "^12.43.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.28.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.zerocam.sharing",
    "productName": "Fabrixly Cam Sharing",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "Fabrixly <admin@fabrixly.com>"
    },
    "artifactName": "FabrixlyCamSharing-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FabrixlyCamSharing-Setup-${version}-${arch}.${ext}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ]
  }
}
